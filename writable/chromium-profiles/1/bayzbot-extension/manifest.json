{
    "manifest_version": 3,
    "name": "BayzBot Player",
    "version": "1.0.0",
    "description": "Connects Dolphin browser profiles to the local BayzBot playback backend.",
    "permissions": [
        "alarms",
        "storage",
        "webRequest",
        "webRequestAuthProvider"
    ],
    "host_permissions": [
        "http://localhost:8765/*",
        "http://127.0.0.1:8765/*",
        "https://music.youtube.com/*",
        "https://www.youtube.com/*",
        "http://*/*",
        "https://*/*"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "matches": [
                "https://music.youtube.com/*",
                "https://www.youtube.com/*"
            ],
            "js": [
                "content.js"
            ],
            "run_at": "document_idle"
        }
    ],
    "options_page": "options.html"
}